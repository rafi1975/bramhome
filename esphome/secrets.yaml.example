# Copy to secrets.yaml next to homey-energy-dongle.yaml.
# In Home Assistant this file already exists at /config/esphome/secrets.yaml —
# add these keys there instead of replacing the file.

wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"

# Fallback hotspot password used only when the dongle cannot join Wi-Fi.
ap_password: "change-this-ap-password"

# Generate with: openssl rand -base64 32
# Used for the Home Assistant API and for later wireless firmware updates.
api_encryption_key: "replace-with-base64-key"

# Only for encrypted P1 ports (for example Luxembourg Smarty). Uncomment
# decryption_key in homey-energy-dongle.yaml to use it.
# dsmr_decryption_key: "00112233445566778899AABBCCDDEEFF"
